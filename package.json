{
  "name": "life-energy-cloud-v2.4",
  "private": true,
  "version": "2.4.0",
  "description": "Life Energy Cloud v2.4",
  "author": "Life Energy Cloud",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:github": "node scripts/build-github-files.mjs",
    "build:exe": "vite build && electron-builder --win portable",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.lifeenergy.cloud.v24",
    "productName": "LifeEnergyCloud-v2.4",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/pwa-192x192.png",
      "public/pwa-512x512.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/pwa-512x512.png"
    },
    "portable": {
      "artifactName": "LifeEnergyCloud-v2.4.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^3.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
